<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpLinkSmoke</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ResonitePath Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- CopyToMods pinned false: THE OFFLINE SUITE MUST NEVER DEPLOY. Without this, building
         the suite fires the mod's DeployToMods and silently restages the (never-locked)
         rml_mods\HotReloadMods DLL that hot_reload loads — the suite reaching production.
         The mod csproj gates its own default too; this pin holds even if that gate drifts. -->
    <ProjectReference Include="..\McpLink.csproj" AdditionalProperties="CopyToMods=false" />
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)\FrooxEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)\Elements.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProtoFlux.Core">
      <HintPath>$(ResonitePath)\ProtoFlux.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Assets">
      <HintPath>$(ResonitePath)\Elements.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

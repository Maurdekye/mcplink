<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>McpLink</RootNamespace>
    <AssemblyName>McpLink</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Resonite install; override with -p:ResonitePath=... -->
    <ResonitePath Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
    <!-- Where StageHotReloadSlot writes its rml_mods\ tree. Defaults to the real install. It is
         separable ONLY so the staging target and the build-never-deploys control
         (tools\dev\verify-build-never-deploys.ps1) can be exercised against a throwaway
         directory — NO TEST MAY TOUCH PRODUCTION. Overriding it does not bypass the
         StageHotReload opt-in; it only redirects where an already-requested staging lands. -->
    <ModsDeployRoot Condition="'$(ModsDeployRoot)' == ''">$(ResonitePath)</ModsDeployRoot>
    <!-- THE BUILD NEVER DEPLOYS (user ruling 2026-08-28; docs/dev/CONTRIBUTING.md "Deploy
         policy"). rml_mods\McpLink.dll is written by tools/deploy.ps1 EXCLUSIVELY - snapshot
         payload, hash pinned at stage time, hard-gated verified backups, both slots. History:
         until 2026-08-28 a direct canonical build auto-deployed both slots, and that machinery
         deployed an unshipped DEBUG build the moment the game happened to be closed - same
         commit stamp as the release build, only the file hash told them apart. A build side
         effect nobody chose is a deploy nobody verified, whichever slot it writes; the old
         CopyToMods gate narrowed WHO could trip it, not WHETHER it was a deploy.
         StageHotReload is the ONE exception, opt-in, default OFF everywhere (canonical tree
         included): a developer deliberately in a hot-reload prototyping loop builds with
         -p:StageHotReload=true and gets the rml_mods\HotReloadMods staging. That slot is never
         locked and is read ONLY by an explicit hot_reload call - RML's startup scan never loads
         it (measured, not reasoned: ResoniteModLoader.AssemblyLoader.GetAssemblyPathsFromDir
         uses the two-argument Directory.EnumerateFiles overload = TopDirectoryOnly, so nothing
         in a subdirectory of rml_mods is loaded at launch and it cannot shadow the real mod).
         Hot reload is for rapid prototyping during implementation; it is never a deploy, and
         nothing this file does constitutes one. -->
    <StageHotReload Condition="'$(StageHotReload)' == ''">false</StageHotReload>
  </PropertyGroup>

  <ItemGroup>
    <!-- the smoke-test and eval-companion projects live in subfolders; keep them out of the mod build -->
    <Compile Remove="test/**" />
    <Compile Remove="eval/**" />
    <!-- tools/apiprobe is a standalone dotnet project too. Without this the SDK's **/*.cs glob
         picks up its generated obj/**/*.AssemblyInfo.cs and the mod build dies with eight
         CS0579 "duplicate assembly attribute" errors that name only the ROOT obj/ files and say
         nothing about the subfolder which actually caused it. Any future standalone project added
         under tools/ is covered by this. -->
    <Compile Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>McpLinkSmoke</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)\FrooxEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)\Elements.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProtoFlux.Core">
      <HintPath>$(ResonitePath)\ProtoFlux.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FrooxEngine.Store">
      <HintPath>$(ResonitePath)\FrooxEngine.Store.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Assets">
      <HintPath>$(ResonitePath)\Elements.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SkyFrost.Base">
      <HintPath>$(ResonitePath)\SkyFrost.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SkyFrost.Base.Models">
      <HintPath>$(ResonitePath)\SkyFrost.Base.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Renderite.Shared">
      <HintPath>$(ResonitePath)\Renderite.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ResoniteModLoader">
      <HintPath>$(ResonitePath)\Libraries\ResoniteModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ResonitePath)\rml_libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- optional at runtime: hot-reload support (guarded behind try/catch in McpLinkMod) -->
    <Reference Include="ResoniteHotReloadLib">
      <HintPath>$(ResonitePath)\rml_libs\ResoniteHotReloadLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Stamp the git commit into AssemblyInformationalVersion so a running mod can name the source
       it was built from (session_info reports it). DELIBERATELY NO BUILD TIMESTAMP: the SDK builds
       deterministically, so the assembly's MVID is a function of its inputs — identical source
       gives an identical MVID, which is what makes session_info's "does the DLL on disk match the
       running build" comparison mean "same code" rather than "same build event". Injecting a
       wall-clock time would make every rebuild look like a different build and turn that check
       into a permanent false alarm. A commit sha is a function of committed state, so it is safe.
       Every step is non-fatal: no git, no repo, or a git that errors just yields "nogit". -->
  <Target Name="StampBuildInfo" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitShaExit" />
    </Exec>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
    </Exec>
    <PropertyGroup>
      <_BuildSource Condition="'$(_GitShaExit)' == '0' AND '$(_GitSha)' != ''">g$(_GitSha.Trim())</_BuildSource>
      <_BuildSource Condition="'$(_BuildSource)' == ''">nogit</_BuildSource>
      <_BuildSource Condition="'$(_GitDirty)' != ''">$(_BuildSource).dirty</_BuildSource>
      <!-- Source id ONLY — deliberately no version number here. $(Version) is the SDK default
           "1.0.0" while the mod's real version is McpLinkMod.VERSION ("2.6.0"), and duplicating
           that constant into the csproj just creates something new to drift. session_info reports
           the version from the constant and this stamp beside it. -->
      <InformationalVersion>$(_BuildSource)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Dev-loop staging ONLY: the slot the hot_reload tool loads. Deliberately NOT paired with
       a rml_mods\McpLink.dll write - that file is tools/deploy.ps1's exclusive property, and a
       build that wrote it would be a deploy nobody verified. The two slots may diverge while
       you prototype; that divergence is confined to your own explicit hot_reload calls (RML
       never loads this slot at startup - see the StageHotReload comment above), and the next
       real deploy rewrites BOTH slots from one verified payload, which re-converges them. -->
  <Target Name="StageHotReloadSlot" AfterTargets="Build" Condition="'$(StageHotReload)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDeployRoot)\rml_mods\HotReloadMods" />
    <Message Text="McpLink: staged $(TargetPath) -> rml_mods\HotReloadMods for the hot-reload DEV loop. This is NOT a deploy: the restart path (rml_mods\McpLink.dll) is untouched and tools/deploy.ps1 owns it."
             Importance="high" />
  </Target>

  <!-- Not a warning, because nothing is wrong: builds not deploying is the designed behavior.
       The message exists so nobody infers from a green build that anything reached the game. -->
  <Target Name="BuildDoesNotDeploy" AfterTargets="Build" Condition="'$(StageHotReload)' != 'true'">
    <Message Text="McpLink: game folder untouched - builds never deploy (user ruling 2026-08-28). Deploy with tools\deploy.ps1; stage the hot-reload dev slot with -p:StageHotReload=true."
             Importance="high" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Companion assembly for McpLink's `eval` tool. McpLink.dll never references Roslyn;
    it lazily loads THIS assembly (plus the Roslyn dependency closure deployed next to it)
    into an isolated AssemblyLoadContext on first eval call. Engine assemblies resolve
    from the game's default context so script types unify with live objects.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>McpLinkEval</RootNamespace>
    <AssemblyName>McpLinkEval</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- pull the full Roslyn dependency closure into the output dir for deployment -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ResonitePath Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
    <!-- Where DeployEvalLibs writes its rml_mods\McpLink_libs tree — same contract as the main
         csproj's ModsDeployRoot: defaults to the real install, separable ONLY so the deploy
         target can be exercised against a throwaway directory. NO TEST MAY TOUCH PRODUCTION.
         Overriding it does not bypass the CopyToMods gate below. -->
    <ModsDeployRoot Condition="'$(ModsDeployRoot)' == ''">$(ResonitePath)</ModsDeployRoot>
    <!-- BUILDS NEVER WRITE THE GAME FOLDER BY DEFAULT (user ruling 2026-08-28, same as
         McpLink.csproj — a build side effect nobody chose is a deploy nobody verified; the
         canonical-path auto-opt-in that used to live here deployed an unshipped Debug build of
         the MAIN mod the moment the game happened to be closed). The eval twist still applies:
         the running mod lazily loads McpLink_libs into an AssemblyLoadContext, so a stray build
         silently replacing those DLLs mixes eval/Roslyn generations under a live game (near-miss
         during the 2.8.1 release packaging). CopyToMods is therefore EXPLICIT-ONLY:
         -p:CopyToMods=true is a deliberate decision every time, no tree opts in by default. -->
    <CopyToMods Condition="'$(CopyToMods)' == ''">false</CopyToMods>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)\FrooxEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)\Elements.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- deploy the eval assembly + Roslyn closure into a SUBFOLDER of rml_mods
       (RML only auto-loads top-level rml_mods\*.dll, so nothing here becomes a "mod") -->
  <Target Name="DeployEvalLibs" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true'">
    <ItemGroup>
      <EvalLibs Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(EvalLibs)" DestinationFolder="$(ModsDeployRoot)\rml_mods\McpLink_libs" ContinueOnError="true" />
    <Message Text="McpLinkEval + Roslyn deployed to $(ModsDeployRoot)\rml_mods\McpLink_libs" Importance="high" />
  </Target>

  <!-- the skip is LOUD, same as the main csproj: a silent no-deploy reads exactly like a
       deploy to whoever builds and then wonders why eval still runs the old closure -->
  <Target Name="DeployEvalLibsSkipped" AfterTargets="Build" Condition="'$(CopyToMods)' != 'true'">
    <Message Text="McpLinkEval: rml_mods\McpLink_libs untouched (builds never write the game folder by default). Writing the eval closure is an explicit decision: -p:CopyToMods=true." Importance="high" />
  </Target>

</Project>

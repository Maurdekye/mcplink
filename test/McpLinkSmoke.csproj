<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpLinkSmoke</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ResonitePath Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- StageHotReload pinned false: THE OFFLINE SUITE MUST NEVER TOUCH THE GAME FOLDER.
         The mod csproj's staging is opt-in-off by default, but this pin holds even if that
         default drifts — building the suite must never restage the (never-locked)
         rml_mods\HotReloadMods DLL that hot_reload loads. (CopyToMods was the old gate's
         name; the pin follows the gate.) -->
    <ProjectReference Include="..\McpLink.csproj" AdditionalProperties="StageHotReload=false" />
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)\FrooxEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)\Elements.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProtoFlux.Core">
      <HintPath>$(ResonitePath)\ProtoFlux.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Assets">
      <HintPath>$(ResonitePath)\Elements.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- colorX's constructors take a ColorProfile, which lives here — needed to construct the
         material colours the renderer_info diagnostics are tested against. Metadata only. -->
    <Reference Include="Renderite.Shared">
      <HintPath>$(ResonitePath)\Renderite.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
